// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  // NOTE: directUrl is deliberately omitted. Prisma 7.8.0 rejects it in
  // schema.prisma ("no longer supported... move to prisma.config.ts") but
  // @prisma/config's Datasource type has no directUrl field either — a real
  // gap in this Prisma version, not a choice. Not an issue yet since local
  // dev connects directly (no pgbouncer pooling). MUST be resolved before
  // connecting to Supabase's pooled DATABASE_URL for real: check whether a
  // newer Prisma release restores support, or fall back to running
  // `prisma migrate` with DATABASE_URL temporarily swapped to the direct
  // (unpooled) connection string.
}

enum Role {
  AGENT
  TEAM_LEAD
  ADMIN
  BROKER
}

model Team {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users   User[]
  invites TeamInvite[]

  @@map("teams")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String?
  name         String?
  role         Role     @default(AGENT)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  team   Team?   @relation(fields: [teamId], references: [id])
  teamId String?

  // IRS Simplified home-office-deduction input (2026-07-24) -- annual
  // deduction = min(homeOfficeSqFt, 300) * $5, computed in
  // src/lib/finance-data.ts, not stored. Null means no deduction shown.
  homeOfficeSqFt Int?

  // The user's own single "federal + state combined" income tax rate guess
  // (2026-07-24) -- persisted so the estimated-quarterly-tax card
  // (src/lib/estimated-tax.ts) doesn't need it retyped on every visit. Not a
  // real bracket calculation; see the "estimate, not tax advice" disclaimer
  // in the UI.
  estimatedIncomeTaxRatePercent Decimal? @db.Decimal(5, 2)

  clients            Client[]
  transactions       Transaction[]
  mileageLogs        MileageLog[]
  documents          Document[]
  sentInvites        TeamInvite[]
  deals              Deal[]
  documentTemplates  DocumentTemplate[]
  assets             Asset[]
  loans              Loan[]
  formTemplates      FormTemplate[]
  formSubmissions    FormSubmission[]
  budgets            Budget[]
  financialGoals     FinancialGoal[]
  recurringTemplates RecurringTransactionTemplate[]
  referralPartners   ReferralPartner[]

  // Backs every teamOrOwnFilter()/teamSharedFilter() manager-view query
  // (src/lib/authorization.ts), which joins through user: { teamId } —
  // the single priciest query shape in the app (e.g. the /team dashboard).
  @@index([teamId])
  @@map("users")
}

// Where a lead came from and how far along they are (2026-07-29 audit
// follow-up) -- both optional/defaulted so this is purely additive over
// existing Client rows, which all read as source=null/stage=NEW.
enum ClientSource {
  REFERRAL
  ZILLOW
  OPEN_HOUSE
  SPHERE
  WEBSITE
  SOCIAL_MEDIA
  OTHER
}

enum ClientStage {
  NEW
  CONTACTED
  NURTURING
  ACTIVE
  CLOSED
  LOST
}

model Client {
  id        String        @id @default(cuid())
  name      String
  email     String?
  phone     String?
  notes     String?
  source    ClientSource?
  stage     ClientStage   @default(NEW)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  documents       Document[]
  deals           Deal[]
  formSubmissions FormSubmission[]
  portalSessions  ClientPortalSession[]
  deadlines       ClientDeadline[]

  @@index([userId])
  @@map("clients")
}

// A reminder tied to a client rather than one specific property/deal (e.g.
// "send pre-approval letter") -- deliberately a separate model from
// DealDeadline, not a nullable-dealId-plus-clientId extension of it.
// DealDeadline's own comment already frames it as the deal's flexible task
// list for Phase 3's automatic per-deal deadline detection; a client-level
// reminder is a different enough concept, and a separate model avoids
// "neither or both FKs set" edge cases. Same flexible label+dueDate shape.
model ClientDeadline {
  id          String    @id @default(cuid())
  label       String
  dueDate     DateTime
  completedAt DateTime?
  createdAt   DateTime  @default(now())

  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
  clientId String

  @@index([clientId])
  @@map("client_deadlines")
}

// A client-facing "magic link" session (2026-07-29) -- deliberately NOT a
// NextAuth/User account (Client isn't part of the Role/team model at all).
// id itself is the unguessable bearer token, matching the same trust model
// already established for TeamInvite/FormSubmissionSigner -- an agent issues
// one via "Send portal access" on the client detail page, the client's
// browser gets an HttpOnly cookie holding this id, and every /portal request
// re-resolves clientId FROM THIS ROW server-side. Never trust a clientId
// passed directly in a request -- that's the exact class of bug fixed
// elsewhere in this same audit pass (see deal-deadlines.ts/form-templates.ts).
model ClientPortalSession {
  id        String   @id @default(cuid())
  expiresAt DateTime
  createdAt DateTime @default(now())

  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
  clientId String

  @@index([clientId])
  @@map("client_portal_sessions")
}

enum TransactionType {
  INCOME
  EXPENSE
}

enum TransactionCategory {
  MILEAGE
  HOME_OFFICE
  PHONE
  MARKETING_ADVERTISING
  MLS_DUES
  CONTINUING_EDUCATION
  CLIENT_GIFTS
  OFFICE_SUPPLIES
  SOFTWARE_SUBSCRIPTIONS
  INSURANCE
  LICENSING_FEES
  MEALS_ENTERTAINMENT
  PROFESSIONAL_SERVICES
  OTHER
}

// BUSINESS is the original (and only, pre-2026-07-20) scope — real estate
// income/expenses. PERSONAL covers everything outside the business (a W-2
// job, a spouse's income, household expenses, etc.), per the Long-Term
// Vision's "one-stop shop" direction in CLAUDE.md. Personal rows don't use
// TransactionCategory (home office/phone/mileage are business-only concepts),
// hence category is nullable below.
enum TransactionScope {
  BUSINESS
  PERSONAL
}

model Transaction {
  id          String               @id @default(cuid())
  type        TransactionType
  scope       TransactionScope     @default(BUSINESS)
  category    TransactionCategory?
  amount      Decimal              @db.Decimal(10, 2)
  description String?
  date        DateTime
  createdAt   DateTime             @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  // Optional link to the deal this expense belongs to (staging, photography,
  // a closing gift) -- same nullable/SetNull pattern as Document.dealId,
  // enabling real per-deal profit/loss (see Deal's commission-split fields).
  deal   Deal?   @relation(fields: [dealId], references: [id], onDelete: SetNull)
  dealId String?

  @@index([userId])
  @@index([dealId])
  @@map("transactions")
}

model MileageLog {
  id          String   @id @default(cuid())
  date        DateTime
  miles       Decimal  @db.Decimal(7, 2)
  isBusiness  Boolean  @default(true)
  note        String?
  ratePerMile Decimal  @db.Decimal(5, 3)
  deduction   Decimal  @db.Decimal(10, 2)
  createdAt   DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  @@index([userId])
  @@map("mileage_logs")
}

model Document {
  id         String   @id @default(cuid())
  fileName   String
  // Object key within the private Supabase Storage "documents" bucket
  // (see src/lib/document-storage.ts). Not a public URL — files are only
  // reachable through the authenticated GET /api/documents/[id] route.
  storageKey String
  mimeType   String
  size       Int
  createdAt  DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  client   Client? @relation(fields: [clientId], references: [id], onDelete: SetNull)
  clientId String?

  deal   Deal?   @relation(fields: [dealId], references: [id], onDelete: SetNull)
  dealId String?

  // Set when this Document is the flattened, signed output of a
  // FormSubmission (see src/lib/pdf-finalize.ts) — reverse side of
  // FormSubmission.completedDocumentId, no FK column on this side.
  formSubmission FormSubmission?

  @@index([userId])
  @@index([clientId])
  @@index([dealId])
  @@map("documents")
}

// Shareable invite link for adding an agent to a team (see CLAUDE.md Platform
// Expansion Roadmap, Phase 2 — no email delivery yet, links are shared manually).
model TeamInvite {
  id        String    @id @default(cuid())
  role      Role      @default(AGENT)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  team   Team   @relation(fields: [teamId], references: [id], onDelete: Cascade)
  teamId String

  createdByUser User   @relation(fields: [createdBy], references: [id], onDelete: Cascade)
  createdBy     String

  @@index([teamId])
  @@map("team_invites")
}

enum DealSide {
  BUYER
  SELLER
  DUAL
}

enum DealStatus {
  ACTIVE
  UNDER_CONTRACT
  PENDING
  CLOSED
  FELL_THROUGH
}

// A real estate transaction/deal (buyer or seller side) — deliberately not
// named `Transaction`, which already means an income/expense ledger entry.
// See CLAUDE.md Platform Expansion Roadmap / Core Data Model for the naming
// collision this avoids. Scoped by userId like every other model here, not a
// separate teamId — team-wide visibility for managers is a query-time join
// through user.teamId (see src/lib/authorization.ts).
model Deal {
  id                    String     @id @default(cuid())
  side                  DealSide
  status                DealStatus @default(ACTIVE)
  propertyAddress       String
  mlsNumber             String?
  listPrice             Decimal?   @db.Decimal(12, 2)
  salePrice             Decimal?   @db.Decimal(12, 2)
  commissionRate        Decimal?   @db.Decimal(5, 2)
  commissionAmount      Decimal?   @db.Decimal(12, 2)
  // Commission-split breakdown (2026-07-24) -- net commission = commissionAmount
  // minus the brokerage's cut, minus any referral fee/team split/other
  // deduction, all flat dollar amounts except brokerageSplitPercent (a %,
  // since brokerage splits are conventionally quoted that way while referral
  // fees/team splits are more often a flat negotiated dollar figure). See
  // src/lib/finance-data.ts's getDealFinancials for the actual computation.
  brokerageSplitPercent Decimal?   @db.Decimal(5, 2)
  referralFeeAmount     Decimal?   @db.Decimal(12, 2)
  teamSplitAmount       Decimal?   @db.Decimal(12, 2)
  otherDeductions       Decimal?   @db.Decimal(12, 2)
  closingDate           DateTime?
  notes                 String?
  createdAt             DateTime   @default(now())
  updatedAt             DateTime   @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  client   Client? @relation(fields: [clientId], references: [id], onDelete: SetNull)
  clientId String?

  // Who referralFeeAmount above is actually owed to (2026-07-29) -- the
  // amount itself stays a flat deduction on the deal; this just attributes it
  // to a specific partner so a running total-owed can be computed.
  referralPartner   ReferralPartner? @relation(fields: [referralPartnerId], references: [id], onDelete: SetNull)
  referralPartnerId String?

  deadlines       DealDeadline[]
  documents       Document[]
  formSubmissions FormSubmission[]
  expenses        Transaction[]
  openHouses      OpenHouse[]

  @@index([userId])
  @@index([clientId])
  @@index([referralPartnerId])
  @@map("deals")
}

// A contact an agent trades referrals with (2026-07-29) -- Deal.referralFeeAmount
// stays a flat per-deal deduction; this just lets those deductions be
// attributed to a specific partner so a running total owed can be computed
// (src/lib/finance-data.ts). Deliberately no payment/disbursement workflow --
// that's a bigger, explicitly out-of-scope feature (see CLAUDE.md).
model ReferralPartner {
  id        String   @id @default(cuid())
  name      String
  email     String?
  phone     String?
  notes     String?
  createdAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  deals Deal[]

  @@index([userId])
  @@map("referral_partners")
}

// A scheduled open house on a Deal's listing (2026-07-29). The public
// sign-in page (/open-house/[id]) needs no login, matching the exact
// unguessable-token trust model Forms already established for /sign/[id] --
// id itself is the link.
model OpenHouse {
  id        String   @id @default(cuid())
  date      DateTime
  startTime String
  endTime   String
  notes     String?
  createdAt DateTime @default(now())

  deal   Deal   @relation(fields: [dealId], references: [id], onDelete: Cascade)
  dealId String

  visitors OpenHouseVisitor[]

  @@index([dealId])
  @@map("open_houses")
}

// One sign-in / showing-feedback record from a public open-house page.
// Deliberately one model covering both open-house walk-ins and private
// showing feedback (the "source" isn't tracked further -- keeping this cheap,
// per the audit's Tier 2 scoping) rather than two near-identical models.
model OpenHouseVisitor {
  id         String   @id @default(cuid())
  name       String
  email      String?
  phone      String?
  interested Boolean?
  feedback   String?
  createdAt  DateTime @default(now())

  openHouse   OpenHouse @relation(fields: [openHouseId], references: [id], onDelete: Cascade)
  openHouseId String

  @@index([openHouseId])
  @@map("open_house_visitors")
}

// Flexible per-deal task list (inspection, financing, closing, or anything
// else an agent adds) — deliberately not fixed fields on Deal, so Phase 3's
// automatic deadline detection can create arbitrary deadlines here too.
model DealDeadline {
  id          String    @id @default(cuid())
  label       String
  dueDate     DateTime
  completedAt DateTime?
  createdAt   DateTime  @default(now())

  deal   Deal   @relation(fields: [dealId], references: [id], onDelete: Cascade)
  dealId String

  @@index([dealId])
  @@map("deal_deadlines")
}

// Brokerage-level shared document template (e.g. a standard purchase
// agreement or listing agreement) — deliberately separate from Document,
// which is a specific client/deal's paperwork. Visibility is *every* team
// member (not just managers, see teamSharedFilter in authorization.ts),
// since the whole point is a shared resource the team can pull from; upload
// and delete are gated to managers (or solo agents, who have no team to
// share with/from) in the server actions. No auto-fill of office/agent info
// yet — see CLAUDE.md Phase 2 step 8 for why that's deliberately deferred.
model DocumentTemplate {
  id         String   @id @default(cuid())
  name       String
  fileName   String
  storageKey String
  mimeType   String
  size       Int
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  @@index([userId])
  @@map("document_templates")
}

enum FormFieldType {
  TEXT
  DATE
  CHECKBOX
  SIGNATURE
  INITIALS
}

enum FormSubmissionStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  DECLINED
}

enum FormSignerStatus {
  PENDING
  VIEWED
  COMPLETED
  DECLINED
}

// What a TEXT/DATE field pulls its value from instead of the signer typing
// it in by hand (2026-07-24, direct founder request — an agent shouldn't
// have to make a client retype info already on file). Null means manual
// entry, today's original behavior. Only meaningful for TEXT/DATE fields —
// a signature/checkbox can't be "auto-filled" from a string.
enum FormFieldAutoFillSource {
  CLIENT_NAME
  CLIENT_EMAIL
  CLIENT_PHONE
  DEAL_PROPERTY_ADDRESS
  DEAL_MLS_NUMBER
  DEAL_LIST_PRICE
  DEAL_SALE_PRICE
  DEAL_CLOSING_DATE
}

// A reusable contract/form PDF with fields placed on it for a client to fill
// in and sign (2026-07-22, direct founder request — "like SkySlope"). Same
// team-shared-library visibility pattern as DocumentTemplate
// (teamSharedFilter / canManageSharedResources in authorization.ts).
// FormTemplate is the definition (the PDF + where its fields go);
// FormSubmission below is one sent instance of it to specific signers.
model FormTemplate {
  id         String   @id @default(cuid())
  name       String
  fileName   String
  storageKey String
  mimeType   String
  size       Int
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  signers     FormTemplateSigner[]
  fields      FormField[]
  submissions FormSubmission[]

  @@index([userId])
  @@map("form_templates")
}

// A signer role defined on a template (e.g. "Buyer", "Seller"). order is
// the sequential signing order used when a submission is sent — signer 2
// isn't emailed until signer 1 completes (see FormSubmissionSigner /
// src/app/actions/form-submissions.ts). Every FormField belongs to exactly
// one of these roles.
model FormTemplateSigner {
  id    String @id @default(cuid())
  order Int
  label String

  formTemplate   FormTemplate @relation(fields: [formTemplateId], references: [id], onDelete: Cascade)
  formTemplateId String

  fields            FormField[]
  submissionSigners FormSubmissionSigner[]

  @@index([formTemplateId])
  @@map("form_template_signers")
}

// One fillable/signable field placed on a template page. x/y/width/height
// are fractions of the page's rendered size (0-1, top-left origin, like
// screen/canvas coordinates) — NOT PDF points — so the same field renders
// correctly at any render width in both the designer and the client fill
// view. See src/lib/pdf-fields.ts for the conversion into PDF point space
// (bottom-left origin) used when finalizing a signed document.
model FormField {
  id       String        @id @default(cuid())
  page     Int
  x        Float
  y        Float
  width    Float
  height   Float
  type     FormFieldType
  label    String
  required Boolean       @default(true)
  order    Int

  autoFillSource FormFieldAutoFillSource?

  formTemplate   FormTemplate @relation(fields: [formTemplateId], references: [id], onDelete: Cascade)
  formTemplateId String

  signer   FormTemplateSigner @relation(fields: [signerId], references: [id], onDelete: Cascade)
  signerId String

  values FormFieldValue[]

  @@index([formTemplateId])
  @@index([signerId])
  @@map("form_fields")
}

// One sent instance of a FormTemplate — the "envelope." Optionally linked to
// a Client and/or Deal like Document, so it surfaces in the same
// client-centric places this app already organizes everything around.
// completedDocumentId points at the finished, flattened, signed PDF once
// every signer is done (src/lib/pdf-finalize.ts) — that PDF is a normal
// Document row, reusing the existing storage/list/download infrastructure
// rather than building a second one for completed forms.
model FormSubmission {
  id          String               @id @default(cuid())
  status      FormSubmissionStatus @default(PENDING)
  createdAt   DateTime             @default(now())
  completedAt DateTime?

  // Restrict, not Cascade: a submission (especially a completed, signed one)
  // is a historical record that must outlive its template — deleting a
  // FormTemplate that has ever been sent should fail, not silently destroy
  // signed documents' provenance. See deleteFormTemplateAction.
  formTemplate   FormTemplate @relation(fields: [formTemplateId], references: [id], onDelete: Restrict)
  formTemplateId String

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  client   Client? @relation(fields: [clientId], references: [id], onDelete: SetNull)
  clientId String?

  deal   Deal?   @relation(fields: [dealId], references: [id], onDelete: SetNull)
  dealId String?

  completedDocument   Document? @relation(fields: [completedDocumentId], references: [id], onDelete: SetNull)
  completedDocumentId String?   @unique

  signers FormSubmissionSigner[]

  @@index([userId])
  @@index([clientId])
  @@index([dealId])
  @@index([formTemplateId])
  @@map("form_submissions")
}

// One actual recipient of a sent FormSubmission, mapped to a signer role
// from the template. id (cuid) doubles as this signer's unguessable link
// token for the public /sign/[id] page — same pattern as TeamInvite.id
// being the join-link token, no separate token field. ipAddress/userAgent/
// consentGivenAt are the audit trail backing a legally-binding e-signature
// (ESIGN Act / UETA) — captured at the moment consent is given, not
// reconstructed after the fact.
model FormSubmissionSigner {
  id             String           @id @default(cuid())
  order          Int
  name           String
  email          String
  status         FormSignerStatus @default(PENDING)
  viewedAt       DateTime?
  consentGivenAt DateTime?
  completedAt    DateTime?
  ipAddress      String?
  userAgent      String?
  createdAt      DateTime         @default(now())

  formSubmission   FormSubmission @relation(fields: [formSubmissionId], references: [id], onDelete: Cascade)
  formSubmissionId String

  templateSigner   FormTemplateSigner @relation(fields: [templateSignerId], references: [id], onDelete: Cascade)
  templateSignerId String

  values FormFieldValue[]

  @@index([formSubmissionId])
  @@index([templateSignerId])
  @@map("form_submission_signers")
}

// One filled-in value for one field, by one signer. value holds plain text
// for TEXT/DATE, "true"/"false" for CHECKBOX, or a signature PNG as a
// base64 data URL for SIGNATURE/INITIALS — small enough to store as text;
// only the final flattened PDF goes into Supabase Storage.
model FormFieldValue {
  id       String   @id @default(cuid())
  value    String
  filledAt DateTime @default(now())

  field   FormField @relation(fields: [fieldId], references: [id], onDelete: Cascade)
  fieldId String

  signer   FormSubmissionSigner @relation(fields: [signerId], references: [id], onDelete: Cascade)
  signerId String

  // @@unique([fieldId, signerId]) below covers fieldId-first lookups
  // (Postgres left-prefix rule) but not a signerId-only filter (e.g.
  // deleting/re-fetching every value for one signer) — needs its own index.
  @@unique([fieldId, signerId])
  @@index([signerId])
  @@map("form_field_values")
}

enum AssetType {
  STOCKS
  RETIREMENT
  REAL_ESTATE
  CRYPTO
  SAVINGS
  OTHER
}

// Personal investment/asset tracking (brokerage account, retirement, rental
// property, crypto, savings, etc.) — part of the Long-Term Vision's shift
// from a business-expense tracker to full personal finance (see CLAUDE.md).
// Deliberately current-value-only for this first version, not a value-history
// log — the user chose simplicity over a true net-worth trend line, which
// would require logging updates over time rather than a single running value.
//
// IMPORTANT: unlike every other team-aware model in this schema, Asset is
// ALWAYS scoped to userId alone, with no team-visibility path whatsoever —
// see src/lib/authorization.ts. Personal finances are never a manager's
// business, even for BROKER/ADMIN/TEAM_LEAD roles that see everything else
// team-wide. Do not wire this into teamOrOwnFilter or teamSharedFilter.
enum WalletNetwork {
  BITCOIN
  STACKS
}

model Asset {
  id           String    @id @default(cuid())
  name         String
  type         AssetType
  currentValue Decimal   @db.Decimal(12, 2)
  notes        String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  // Optional live wallet tracking for CRYPTO-type assets (2026-07-20) — when
  // set, currentValue is computed from the on-chain balance × a fetched USD
  // price (see src/lib/wallet-balance.ts) rather than typed in by hand.
  // Fetched on add and whenever the user hits "Refresh," not on every page
  // view or on a schedule — no background job/cron, keeps this at zero
  // infra cost and avoids hammering free public block-explorer APIs.
  walletNetwork          WalletNetwork?
  walletAddress          String?
  walletBalance          Decimal?       @db.Decimal(24, 8) // raw on-chain amount (BTC or STX), not USD
  walletBalanceCheckedAt DateTime?

  // Optional live stock tracking for STOCKS-type assets (2026-07-26) — same
  // pattern as the wallet fields above: when stockTicker is set, currentValue
  // is computed from shareCount × a fetched per-share price (see
  // src/lib/stock-price.ts) instead of typed in by hand. shareCount is the
  // one thing we can't look up (unlike a wallet address, a ticker alone
  // doesn't reveal how many shares someone owns) — the user enters that,
  // only the price is fetched. Same on-demand-only fetch discipline: on add
  // and on "Refresh," never polled.
  stockTicker         String?
  shareCount          Decimal?  @db.Decimal(14, 4) // supports fractional shares
  stockPricePerShare  Decimal?  @db.Decimal(12, 4)
  stockPriceCheckedAt DateTime?

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  valueSnapshots AssetValueSnapshot[]
  financialGoals FinancialGoal[]

  @@index([userId])
  @@map("assets")
}

// A timestamped value log entry, written automatically whenever an Asset's
// currentValue is set (create or update) -- 2026-07-24, enables a real net
// worth trend line (src/lib/finance-data.ts's getNetWorthSeries) without any
// extra "log a snapshot" UI. Existing assets got one backfilled at migration
// time so the chart isn't empty on day one.
model AssetValueSnapshot {
  id         String   @id @default(cuid())
  value      Decimal  @db.Decimal(12, 2)
  recordedAt DateTime @default(now())

  asset   Asset  @relation(fields: [assetId], references: [id], onDelete: Cascade)
  assetId String

  @@index([assetId])
  @@map("asset_value_snapshots")
}

enum LoanType {
  MORTGAGE
  AUTO
  OTHER
}

// Personal loan/debt tracking (mortgage, auto, or other installment loans) —
// 2026-07-20, direct founder request ("mortgage section... car payment...
// all in one"). Same personal-only, never-team-visible pattern as Asset —
// see Architecture Principles. Amortization math is never stored per-month;
// monthly payment, the current principal/interest split, and remaining
// balance are all derived on read from the fields below (see
// src/lib/loan-calculations.ts) rather than persisted, so there's nothing to
// keep in sync if the founder edits the rate or term later.
model Loan {
  id                String   @id @default(cuid())
  name              String
  type              LoanType
  purchasePrice     Decimal  @db.Decimal(12, 2)
  downPayment       Decimal  @default(0) @db.Decimal(12, 2)
  interestRate      Decimal  @db.Decimal(5, 3) // annual percent, e.g. 6.500
  termMonths        Int
  startDate         DateTime
  annualPropertyTax Decimal  @default(0) @db.Decimal(12, 2)
  annualInsurance   Decimal  @default(0) @db.Decimal(12, 2)
  // Expected annual home-value appreciation, MORTGAGE-only (see the "Home
  // value & equity projection" chart) — 2026-07-20 addition. Harmless as a
  // generic field with a sane default for AUTO/OTHER, which just never
  // surface it in the UI.
  appreciationRate  Decimal  @default(3.5) @db.Decimal(5, 3)
  // Manual override of "what the home is worth right now" (2026-07-20) --
  // e.g. a rehab added value beyond what pure appreciation from the
  // purchase price would predict. When set, the home-value projection
  // anchors its FUTURE segment (from today forward) on this number instead
  // of the purchase-price appreciation curve; the historical segment (loan
  // start date to today) is unaffected. Null means "just use the
  // appreciation estimate," the original behavior.
  currentHomeValue  Decimal? @db.Decimal(12, 2)
  notes             String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user          User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId        String
  extraPayments LoanExtraPayment[]

  @@index([userId])
  @@map("loans")
}

// One-off extra-principal payments a user logs against a loan (2026-07-20,
// direct founder request — "when I do extra payments to the principle...
// updates the mortgage chart to show a new payoff date"). Applied in
// src/lib/loan-calculations.ts's amortization simulation at the month they
// fall in; the loan's own monthly P&I payment amount is never changed by
// these, only the payoff date moves up — the standard way extra-principal
// payments work on a fixed-rate loan.
model LoanExtraPayment {
  id        String   @id @default(cuid())
  date      DateTime
  amount    Decimal  @db.Decimal(12, 2)
  notes     String?
  createdAt DateTime @default(now())

  loan   Loan   @relation(fields: [loanId], references: [id], onDelete: Cascade)
  loanId String

  @@index([loanId])
  @@map("loan_extra_payments")
}

// A monthly spending limit for one category (or an overall scope-wide limit
// when category is null) -- 2026-07-24. Actual spend for the current month
// is computed on read from Transaction, never stored, same "derive don't
// persist" philosophy as the loan amortization schedule.
model Budget {
  id           String               @id @default(cuid())
  scope        TransactionScope
  category     TransactionCategory?
  monthlyLimit Decimal              @db.Decimal(12, 2)
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  // No separate @@index([userId]) needed -- the compound unique below
  // already leads with userId, so a userId-only filter (getBudgetUsage)
  // is served by it via Postgres's left-prefix rule.
  @@unique([userId, scope, category])
  @@map("budgets")
}

// A savings/debt-payoff goal (2026-07-24) -- currentAmount is either updated
// by hand, or (when linkedAsset is set) tracks that Asset's live currentValue
// instead, e.g. "House down payment fund" pointed at a Savings-type asset.
model FinancialGoal {
  id            String    @id @default(cuid())
  name          String
  targetAmount  Decimal   @db.Decimal(12, 2)
  currentAmount Decimal   @default(0) @db.Decimal(12, 2)
  targetDate    DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  linkedAsset   Asset?  @relation(fields: [linkedAssetId], references: [id], onDelete: SetNull)
  linkedAssetId String?

  @@index([userId])
  @@map("financial_goals")
}

enum RecurringFrequency {
  MONTHLY
  QUARTERLY
  ANNUAL
}

// A recurring cost template (MLS dues, E&O insurance, a software
// subscription) -- 2026-07-24, deliberately reminder-only, not silent
// auto-creation (no cron infra, and no surprise numbers): nextDueDate is
// checked on page load in src/lib/finance-data.ts, surfaced as a "due now"
// card, and only becomes a real Transaction when the user clicks "Log it"
// (src/app/actions/recurring-transactions.ts), which also advances
// nextDueDate by one frequency interval.
model RecurringTransactionTemplate {
  id           String               @id @default(cuid())
  scope        TransactionScope
  type         TransactionType
  category     TransactionCategory?
  amount       Decimal              @db.Decimal(10, 2)
  description  String?
  frequency    RecurringFrequency
  nextDueDate  DateTime
  lastLoggedAt DateTime?
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt

  // Optional business-use split, EXPENSE templates only (2026-07-28) -- e.g.
  // a phone bill that's 60% business use. When set, each auto-logged period
  // creates TWO Transaction rows (business portion + personal portion, via
  // splitByBusinessUse in src/lib/recurring.ts) instead of one. Null means no
  // split -- the original single-scope behavior is unchanged. Never applies
  // to INCOME templates; scope above still drives those as before.
  businessUsePercent Decimal? @db.Decimal(5, 2)

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  @@index([userId])
  @@map("recurring_transaction_templates")
}

// Config table for state-specific mileage deduction rates, kept easy to
// update annually and extend beyond Michigan (see CLAUDE.md architecture principles).
model MileageRate {
  id          String  @id @default(cuid())
  state       String
  year        Int
  ratePerMile Decimal @db.Decimal(5, 3)

  @@unique([state, year])
  @@map("mileage_rates")
}

// Basic rate limiting (2026-07-30) -- one row per attempt, keyed by e.g.
// "login:{ip}" or "pdf:{userId}". No Redis/external service: this reuses the
// shared Postgres already paid for, matching this app's cost-conscious
// pattern. Old rows are opportunistically pruned by src/lib/rate-limit.ts on
// each check rather than via a cron job -- same "catch up on next visit"
// philosophy as recurring transactions, so this table never needs external
// maintenance.
model RateLimitAttempt {
  id        String   @id @default(cuid())
  key       String
  createdAt DateTime @default(now())

  @@index([key, createdAt])
  @@map("rate_limit_attempts")
}

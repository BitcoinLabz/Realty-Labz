// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  // NOTE: directUrl is deliberately omitted. Prisma 7.8.0 rejects it in
  // schema.prisma ("no longer supported... move to prisma.config.ts") but
  // @prisma/config's Datasource type has no directUrl field either — a real
  // gap in this Prisma version, not a choice. Not an issue yet since local
  // dev connects directly (no pgbouncer pooling). MUST be resolved before
  // connecting to Supabase's pooled DATABASE_URL for real: check whether a
  // newer Prisma release restores support, or fall back to running
  // `prisma migrate` with DATABASE_URL temporarily swapped to the direct
  // (unpooled) connection string.
}

enum Role {
  AGENT
  TEAM_LEAD
  ADMIN
  BROKER
}

model Team {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users   User[]
  invites TeamInvite[]

  @@map("teams")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String?
  role         Role     @default(AGENT)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  team   Team?   @relation(fields: [teamId], references: [id])
  teamId String?

  clients      Client[]
  transactions Transaction[]
  mileageLogs  MileageLog[]
  documents    Document[]
  sentInvites  TeamInvite[]

  @@map("users")
}

model Client {
  id        String   @id @default(cuid())
  name      String
  email     String?
  phone     String?
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  documents Document[]

  @@map("clients")
}

enum TransactionType {
  INCOME
  EXPENSE
}

enum TransactionCategory {
  MILEAGE
  HOME_OFFICE
  PHONE
  OTHER
}

model Transaction {
  id          String              @id @default(cuid())
  type        TransactionType
  category    TransactionCategory
  amount      Decimal             @db.Decimal(10, 2)
  description String?
  date        DateTime
  createdAt   DateTime            @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  @@map("transactions")
}

model MileageLog {
  id         String   @id @default(cuid())
  date       DateTime
  miles      Decimal  @db.Decimal(7, 2)
  isBusiness Boolean  @default(true)
  note       String?
  ratePerMile Decimal @db.Decimal(5, 3)
  deduction  Decimal  @db.Decimal(10, 2)
  createdAt  DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  @@map("mileage_logs")
}

model Document {
  id         String   @id @default(cuid())
  fileName   String
  // Object key within the private Supabase Storage "documents" bucket
  // (see src/lib/document-storage.ts). Not a public URL — files are only
  // reachable through the authenticated GET /api/documents/[id] route.
  storageKey String
  mimeType   String
  size       Int
  createdAt  DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  client   Client? @relation(fields: [clientId], references: [id], onDelete: SetNull)
  clientId String?

  @@map("documents")
}

// Shareable invite link for adding an agent to a team (see CLAUDE.md Platform
// Expansion Roadmap, Phase 2 — no email delivery yet, links are shared manually).
model TeamInvite {
  id        String    @id @default(cuid())
  role      Role      @default(AGENT)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  team   Team   @relation(fields: [teamId], references: [id], onDelete: Cascade)
  teamId String

  createdByUser User   @relation(fields: [createdBy], references: [id], onDelete: Cascade)
  createdBy     String

  @@map("team_invites")
}

// Config table for state-specific mileage deduction rates, kept easy to
// update annually and extend beyond Michigan (see CLAUDE.md architecture principles).
model MileageRate {
  id          String  @id @default(cuid())
  state       String
  year        Int
  ratePerMile Decimal @db.Decimal(5, 3)

  @@unique([state, year])
  @@map("mileage_rates")
}

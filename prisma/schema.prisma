// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  // NOTE: directUrl is deliberately omitted. Prisma 7.8.0 rejects it in
  // schema.prisma ("no longer supported... move to prisma.config.ts") but
  // @prisma/config's Datasource type has no directUrl field either — a real
  // gap in this Prisma version, not a choice. Not an issue yet since local
  // dev connects directly (no pgbouncer pooling). MUST be resolved before
  // connecting to Supabase's pooled DATABASE_URL for real: check whether a
  // newer Prisma release restores support, or fall back to running
  // `prisma migrate` with DATABASE_URL temporarily swapped to the direct
  // (unpooled) connection string.
}

enum Role {
  AGENT
  TEAM_LEAD
  ADMIN
  BROKER
}

model Team {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users   User[]
  invites TeamInvite[]

  @@map("teams")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String?
  role         Role     @default(AGENT)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  team   Team?   @relation(fields: [teamId], references: [id])
  teamId String?

  clients           Client[]
  transactions      Transaction[]
  mileageLogs       MileageLog[]
  documents         Document[]
  sentInvites       TeamInvite[]
  deals             Deal[]
  documentTemplates DocumentTemplate[]
  assets            Asset[]

  @@map("users")
}

model Client {
  id        String   @id @default(cuid())
  name      String
  email     String?
  phone     String?
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  documents Document[]
  deals     Deal[]

  @@map("clients")
}

enum TransactionType {
  INCOME
  EXPENSE
}

enum TransactionCategory {
  MILEAGE
  HOME_OFFICE
  PHONE
  OTHER
}

// BUSINESS is the original (and only, pre-2026-07-20) scope — real estate
// income/expenses. PERSONAL covers everything outside the business (a W-2
// job, a spouse's income, household expenses, etc.), per the Long-Term
// Vision's "one-stop shop" direction in CLAUDE.md. Personal rows don't use
// TransactionCategory (home office/phone/mileage are business-only concepts),
// hence category is nullable below.
enum TransactionScope {
  BUSINESS
  PERSONAL
}

model Transaction {
  id          String               @id @default(cuid())
  type        TransactionType
  scope       TransactionScope     @default(BUSINESS)
  category    TransactionCategory?
  amount      Decimal              @db.Decimal(10, 2)
  description String?
  date        DateTime
  createdAt   DateTime             @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  @@map("transactions")
}

model MileageLog {
  id         String   @id @default(cuid())
  date       DateTime
  miles      Decimal  @db.Decimal(7, 2)
  isBusiness Boolean  @default(true)
  note       String?
  ratePerMile Decimal @db.Decimal(5, 3)
  deduction  Decimal  @db.Decimal(10, 2)
  createdAt  DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  @@map("mileage_logs")
}

model Document {
  id         String   @id @default(cuid())
  fileName   String
  // Object key within the private Supabase Storage "documents" bucket
  // (see src/lib/document-storage.ts). Not a public URL — files are only
  // reachable through the authenticated GET /api/documents/[id] route.
  storageKey String
  mimeType   String
  size       Int
  createdAt  DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  client   Client? @relation(fields: [clientId], references: [id], onDelete: SetNull)
  clientId String?

  deal   Deal?   @relation(fields: [dealId], references: [id], onDelete: SetNull)
  dealId String?

  @@map("documents")
}

// Shareable invite link for adding an agent to a team (see CLAUDE.md Platform
// Expansion Roadmap, Phase 2 — no email delivery yet, links are shared manually).
model TeamInvite {
  id        String    @id @default(cuid())
  role      Role      @default(AGENT)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  team   Team   @relation(fields: [teamId], references: [id], onDelete: Cascade)
  teamId String

  createdByUser User   @relation(fields: [createdBy], references: [id], onDelete: Cascade)
  createdBy     String

  @@map("team_invites")
}

enum DealSide {
  BUYER
  SELLER
  DUAL
}

enum DealStatus {
  ACTIVE
  UNDER_CONTRACT
  PENDING
  CLOSED
  FELL_THROUGH
}

// A real estate transaction/deal (buyer or seller side) — deliberately not
// named `Transaction`, which already means an income/expense ledger entry.
// See CLAUDE.md Platform Expansion Roadmap / Core Data Model for the naming
// collision this avoids. Scoped by userId like every other model here, not a
// separate teamId — team-wide visibility for managers is a query-time join
// through user.teamId (see src/lib/authorization.ts).
model Deal {
  id               String     @id @default(cuid())
  side             DealSide
  status           DealStatus @default(ACTIVE)
  propertyAddress  String
  mlsNumber        String?
  listPrice        Decimal?   @db.Decimal(12, 2)
  salePrice        Decimal?   @db.Decimal(12, 2)
  commissionRate   Decimal?   @db.Decimal(5, 2)
  commissionAmount Decimal?   @db.Decimal(12, 2)
  closingDate      DateTime?
  notes            String?
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  client   Client? @relation(fields: [clientId], references: [id], onDelete: SetNull)
  clientId String?

  deadlines DealDeadline[]
  documents Document[]

  @@map("deals")
}

// Flexible per-deal task list (inspection, financing, closing, or anything
// else an agent adds) — deliberately not fixed fields on Deal, so Phase 3's
// automatic deadline detection can create arbitrary deadlines here too.
model DealDeadline {
  id          String    @id @default(cuid())
  label       String
  dueDate     DateTime
  completedAt DateTime?
  createdAt   DateTime  @default(now())

  deal   Deal   @relation(fields: [dealId], references: [id], onDelete: Cascade)
  dealId String

  @@map("deal_deadlines")
}

// Brokerage-level shared document template (e.g. a standard purchase
// agreement or listing agreement) — deliberately separate from Document,
// which is a specific client/deal's paperwork. Visibility is *every* team
// member (not just managers, see teamSharedFilter in authorization.ts),
// since the whole point is a shared resource the team can pull from; upload
// and delete are gated to managers (or solo agents, who have no team to
// share with/from) in the server actions. No auto-fill of office/agent info
// yet — see CLAUDE.md Phase 2 step 8 for why that's deliberately deferred.
model DocumentTemplate {
  id         String   @id @default(cuid())
  name       String
  fileName   String
  storageKey String
  mimeType   String
  size       Int
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  @@map("document_templates")
}

enum AssetType {
  STOCKS
  RETIREMENT
  REAL_ESTATE
  CRYPTO
  SAVINGS
  OTHER
}

// Personal investment/asset tracking (brokerage account, retirement, rental
// property, crypto, savings, etc.) — part of the Long-Term Vision's shift
// from a business-expense tracker to full personal finance (see CLAUDE.md).
// Deliberately current-value-only for this first version, not a value-history
// log — the user chose simplicity over a true net-worth trend line, which
// would require logging updates over time rather than a single running value.
//
// IMPORTANT: unlike every other team-aware model in this schema, Asset is
// ALWAYS scoped to userId alone, with no team-visibility path whatsoever —
// see src/lib/authorization.ts. Personal finances are never a manager's
// business, even for BROKER/ADMIN/TEAM_LEAD roles that see everything else
// team-wide. Do not wire this into teamOrOwnFilter or teamSharedFilter.
model Asset {
  id           String    @id @default(cuid())
  name         String
  type         AssetType
  currentValue Decimal   @db.Decimal(12, 2)
  notes        String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  @@map("assets")
}

// Config table for state-specific mileage deduction rates, kept easy to
// update annually and extend beyond Michigan (see CLAUDE.md architecture principles).
model MileageRate {
  id          String  @id @default(cuid())
  state       String
  year        Int
  ratePerMile Decimal @db.Decimal(5, 3)

  @@unique([state, year])
  @@map("mileage_rates")
}
